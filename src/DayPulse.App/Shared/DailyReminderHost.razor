@using DayPulse.Core
@using DayPulse.Core.Repositories
@inject ISettingsRepository SettingsRepository
@inject ICheckInRepository CheckInRepository
@inject TimeProvider Clock
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Localizer
@inject ILogger<DailyReminderHost> Logger
@implements IAsyncDisposable

@if (_showReminder)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close"
              ShowCloseIcon="true" CloseIconClicked="Dismiss">
        @Localizer["ReminderMessage"]
        <MudButton Href="/check-in" Color="Color.Primary" OnClick="Dismiss">@Localizer["ReminderCheckIn"]</MudButton>
    </MudAlert>
}
@if (_failed)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" role="alert">
        @Localizer["ReminderDeliveryError"]
        <MudButton OnClick="StartPolling">@Localizer["TryAgain"]</MudButton>
    </MudAlert>
}

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private ReminderInterop? _interop;
    private Task? _pollTask;
    private DateOnly? _lastShownDate;
    private bool _showReminder;
    private bool _failed;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interop = new ReminderInterop(JS);
            StartPolling();
        }
        return Task.CompletedTask;
    }

    private void StartPolling()
    {
        if (_pollTask is { IsCompleted: false })
        {
            return;
        }
        _failed = false;
        _pollTask = PollAsync();
    }

    private void Dismiss() => _showReminder = false;

    private async Task PollAsync()
    {
        try
        {
            while (!_cancellation.IsCancellationRequested)
            {
                var now = Clock.GetLocalNow().DateTime;
                var today = DateOnly.FromDateTime(now);
                var settings = await SettingsRepository.LoadAsync(_cancellation.Token);
                if (!settings.ReminderEnabled)
                {
                    if (_showReminder)
                    {
                        _showReminder = false;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                else
                {
                    var entry = await CheckInRepository.GetByDateAsync(today, _cancellation.Token);
                    if (entry is not null && _showReminder)
                    {
                        _showReminder = false;
                        await InvokeAsync(StateHasChanged);
                    }
                    if (DailyReminderSchedule.IsDue(true, settings.ReminderTime, now,
                            entry is not null, _lastShownDate))
                    {
                        var shown = await _interop!.ShowOnceAsync(
                            today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
                            Localizer["ApplicationName"], Localizer["ReminderMessage"]);
                        _lastShownDate = today;
                        _showReminder = shown;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                await Task.Delay(TimeSpan.FromSeconds(30), Clock, _cancellation.Token);
            }
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            Logger.LogDebug("Daily reminder monitoring stopped.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Daily reminder monitoring failed.");
            _failed = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cancellation.Cancel();
        if (_pollTask is not null)
        {
            await _pollTask;
        }
        if (_interop is not null)
        {
            await _interop.DisposeAsync();
        }
        _cancellation.Dispose();
    }
}
