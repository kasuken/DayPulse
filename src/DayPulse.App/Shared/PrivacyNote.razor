@inject IStringLocalizer<SharedResource> Localizer

<div class="daypulse-privacy-note">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Color="Color.Primary" aria-hidden="true" />
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle2">@Localizer["PrivacyHeading"]</MudText>
            <MudText Typo="Typo.body2" Class="daypulse-muted">@Localizer["PrivacyDescription"]</MudText>
        </MudStack>
    </MudStack>
</div>
