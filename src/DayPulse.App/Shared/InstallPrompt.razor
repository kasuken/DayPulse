@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer

@if (_isVisible && _hasState)
{
    <div
        class="daypulse-install-prompt"
        role="region"
        aria-live="polite"
        aria-labelledby="daypulse-install-prompt-title"
        data-testid="daypulse-install-prompt">
        <MudPaper Class="daypulse-install-prompt__surface" Elevation="6">
            <div class="daypulse-install-prompt__header">
                <div>
                    <MudText Typo="Typo.h6" id="daypulse-install-prompt-title">
                        @Localizer["InstallDayPulse"]
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @Localizer["InstallDescription"]
                    </MudText>
                </div>

                <button
                    type="button"
                    class="daypulse-install-prompt__close"
                    aria-label='@Localizer["DismissInstallGuidance"]'
                    @onclick="DismissAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>

            @if (_state.IsIosSafari)
            {
                <MudText Typo="Typo.body2">
                    @Localizer["InstallIosDescription"]
                </MudText>
                <ol class="daypulse-install-prompt__steps">
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Share" aria-hidden="true" />
                        <span>@((MarkupString)Localizer["InstallIosShareStep"].Value)</span>
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Home" aria-hidden="true" />
                        <span>@((MarkupString)Localizer["InstallIosAddHomeStep"].Value)</span>
                    </li>
                </ol>
            }
            else if (_state.IsAndroid && !_state.CanPrompt)
            {
                <MudText Typo="Typo.body2">
                    @Localizer["InstallAndroidMenuDescription"]
                </MudText>
                <ol class="daypulse-install-prompt__steps">
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.MoreVert" aria-hidden="true" />
                        <span>@((MarkupString)Localizer["InstallAndroidMenuStep"].Value)</span>
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Filled.Home" aria-hidden="true" />
                        <span>@((MarkupString)Localizer["InstallAndroidAddStep"].Value)</span>
                    </li>
                </ol>
            }
            else if (_state.IsAndroid)
            {
                <MudText Typo="Typo.body2">
                    @Localizer["InstallAndroidPromptDescription"]
                </MudText>
            }

            <div class="daypulse-install-prompt__actions">
                @if (_state.IsAndroid && _state.CanPrompt)
                {
                    <MudButton
                        Color="Color.Primary"
                        Variant="Variant.Filled"
                        StartIcon="@Icons.Material.Filled.Download"
                        OnClick="InstallAsync"
                        data-testid="daypulse-install-prompt-install">
                        @Localizer["Install"]
                    </MudButton>
                }

                <MudButton
                    Color="Color.Primary"
                    Variant="Variant.Text"
                    OnClick="DismissAsync"
                    data-testid="daypulse-install-prompt-got-it">
                    @Localizer["GotIt"]
                </MudButton>

                <MudButton
                    Color="Color.Secondary"
                    Variant="Variant.Text"
                    OnClick="DismissPermanentlyAsync"
                    data-testid="daypulse-install-prompt-dont-show-again">
                    @Localizer["DontShowAgain"]
                </MudButton>
            </div>
        </MudPaper>
    </div>
}
