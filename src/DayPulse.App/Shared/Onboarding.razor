@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["OnboardingPageTitle"]</PageTitle>

<MudStack Spacing="6" data-testid="daypulse-onboarding">
    <PageHeader Title="@Localizer["OnboardingWelcome"]" Description="@Localizer["OnboardingIntroduction"]" />
    <MudText Typo="Typo.body2" role="status">@Localizer["OnboardingStep", _step + 1, 3]</MudText>
    <MudPaper Class="daypulse-panel pa-6" Elevation="0">
        <MudStack Spacing="4">
            @if (_step == 0)
            {
                <MudText Typo="Typo.h2">@Localizer["OnboardingSmallHabit"]</MudText>
                <MudText>@Localizer["OnboardingCheckInDescription"]</MudText>
                <MudText>@Localizer["OnboardingNoMedicalClaims"]</MudText>
            }
            else if (_step == 1)
            {
                <MudText Typo="Typo.h2">@Localizer["OnboardingPrivacyTitle"]</MudText>
                <MudText>@Localizer["OnboardingPrivacyDescription"]</MudText>
                <MudAlert Severity="Severity.Info">@Localizer["OnboardingStorageWarning"]</MudAlert>
                <MudText>@Localizer["OnboardingExportDescription"]</MudText>
            }
            else
            {
                <MudText Typo="Typo.h2">@Localizer["OnboardingMetricsTitle"]</MudText>
                <MudText>@Localizer["OnboardingMetricsDescription"]</MudText>
                <MudSwitch T="bool" @bind-Value="_energy" Label="@Localizer["OnboardingEnergy"]" Color="Color.Primary" Disabled="@_saving" />
                <MudSwitch T="bool" @bind-Value="_anxiety" Label="@Localizer["OnboardingAnxiety"]" Color="Color.Primary" Disabled="@_saving" />
                <MudSwitch T="bool" @bind-Value="_focus" Label="@Localizer["OnboardingFocus"]" Color="Color.Primary" Disabled="@_saving" />
                <MudSwitch T="bool" @bind-Value="_sleep" Label="@Localizer["OnboardingSleep"]" Color="Color.Primary" Disabled="@_saving" />
            }
            @if (_failed)
            {
                <MudAlert Severity="Severity.Error" role="alert">@Localizer["OnboardingSaveError"]</MudAlert>
            }
            <MudStack Row="true" Spacing="3">
                @if (_step > 0)
                {
                    <MudButton OnClick="Back" Disabled="@_saving">@Localizer["OnboardingBack"]</MudButton>
                }
                @if (_step < 2)
                {
                    <MudButton OnClick="Next" Variant="Variant.Filled" Color="Color.Primary">@Localizer["OnboardingContinue"]</MudButton>
                }
                else
                {
                    <MudButton OnClick="FinishAsync" Disabled="@_saving" Variant="Variant.Filled" Color="Color.Primary"
                               data-testid="daypulse-onboarding-finish">
                        @Localizer[_saving ? "OnboardingSaving" : "OnboardingFinish"]
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </MudPaper>
</MudStack>
