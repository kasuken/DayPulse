@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["PageNotFoundPageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["PageNotFoundHeading"]" Description="@Localizer["PageNotFoundDescription"]" />
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="align-self-start">
        @Localizer["BackToToday"]
    </MudButton>
</MudStack>