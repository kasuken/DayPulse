@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["PageNotFoundPageTitle"]</PageTitle>

<MudStack Spacing="2">
    <MudText Typo="Typo.h1">@Localizer["PageNotFoundHeading"]</MudText>
    <MudText Color="Color.Secondary">
        @Localizer["PageNotFoundDescription"]
    </MudText>
</MudStack>