@page "/insights"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["InsightsPageTitle"]</PageTitle>

<MudStack Spacing="6">
    <PageHeader Title="@Localizer["Insights"]" Description="@Localizer["InsightsDescription"]" />
    <EmptyFeatureState Icon="@Icons.Material.Outlined.Insights"
                       Title="@Localizer["InsightsEmptyHeading"]"
                       Description="@Localizer["InsightsEmptyDescription"]" />
    <PrivacyNote />
</MudStack>
