@page "/history"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["HistoryPageTitle"]</PageTitle>

<MudStack Spacing="6">
    <PageHeader Title="@Localizer["History"]" Description="@Localizer["HistoryDescription"]" />
    <EmptyFeatureState Icon="@Icons.Material.Outlined.History"
                       Title="@Localizer["HistoryEmptyHeading"]"
                       Description="@Localizer["HistoryEmptyDescription"]" />
    <PrivacyNote />
</MudStack>
