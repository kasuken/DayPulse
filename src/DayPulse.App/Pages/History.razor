@page "/history"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["HistoryPageTitle"]</PageTitle>

<MudStack Spacing="2">
    <MudText Typo="Typo.h1">@Localizer["History"]</MudText>
    <MudText Color="Color.Secondary">
        @Localizer["HistoryDescription"]
    </MudText>
</MudStack>
