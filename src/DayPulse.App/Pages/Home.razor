@page "/"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["HomePageTitle"]</PageTitle>

<MudStack Spacing="4" data-testid="daypulse-home">
    <MudText Typo="Typo.h1">@Localizer["ApplicationName"]</MudText>
    <MudText Typo="Typo.body1">
        @Localizer["HomeDescription"]
    </MudText>

    <MudPaper Elevation="1" Class="pa-6">
        <MudText Typo="Typo.h5">@Localizer["HomeReadyHeading"]</MudText>
        <MudText Color="Color.Secondary">
            @Localizer["HomeReadyMessage"]
        </MudText>
    </MudPaper>
</MudStack>
