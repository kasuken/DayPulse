@using DayPulse.Core.Repositories
@inject IActivityRepository ActivityRepository
@inject CultureState CultureState
@inject ILogger<App> Logger
@inject IStringLocalizer<SharedResource> Localizer
@implements IDisposable
@implements IAsyncDisposable

<BrowserLocaleInitializer />
<ThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<InstallPrompt />

@if (_initializationError is not null)
{
    <main class="pa-4" role="alert">
        <h1>@Localizer["LocalStorageUnavailableTitle"]</h1>
        <p>@Localizer["LocalStorageUnavailableMessage"]</p>
    </main>
}
else
{
    <Router
        @key="CultureState.CurrentCulture.Name"
        AppAssembly="@typeof(App).Assembly"
        NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
}

@code {
    private CancellationTokenSource? _initializationCancellation;
    private Task? _initializationTask;
    private Exception? _initializationError;

    protected override void OnInitialized()
    {
        CultureState.Changed += OnCultureChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _initializationCancellation = new CancellationTokenSource();
        _initializationTask = InitializeAsync(_initializationCancellation.Token);
        await _initializationTask;
    }

    public void Dispose()
    {
        CultureState.Changed -= OnCultureChanged;
    }

    public async ValueTask DisposeAsync()
    {
        CultureState.Changed -= OnCultureChanged;

        var initializationCancellation = _initializationCancellation;
        _initializationCancellation = null;
        if (initializationCancellation is null)
        {
            return;
        }

        initializationCancellation.Cancel();
        if (_initializationTask is not null)
        {
            await _initializationTask;
        }

        initializationCancellation.Dispose();
    }

    private void OnCultureChanged(object? sender, EventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task InitializeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await ActivityRepository.SeedDefaultsAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "DayPulse local data initialization failed.");
            _initializationError = exception;
            await InvokeAsync(StateHasChanged);
        }
    }
}
