@using DayPulse.Core.Repositories
@inject IActivityRepository ActivityRepository
@inject ISettingsRepository SettingsRepository
@inject CultureState CultureState
@inject ILogger<App> Logger
@inject IStringLocalizer<SharedResource> Localizer
@implements IDisposable
@implements IAsyncDisposable

<BrowserLocaleInitializer />
<ThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!_initialized && _initializationError is null)
{
    <main class="pa-6" role="status">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <p>@Localizer["OnboardingLoading"]</p>
    </main>
}
else if (_initializationError is not null)
{
    <main class="pa-4" role="alert">
        <h1>@Localizer["LocalStorageUnavailableTitle"]</h1>
        <p>@Localizer["LocalStorageUnavailableMessage"]</p>
        <MudButton OnClick="RetryInitializationAsync" Variant="Variant.Filled" Color="Color.Primary">
            @Localizer["TryAgain"]
        </MudButton>
    </main>
}
else if (!_settings.OnboardingCompleted)
{
    <LayoutView Layout="@typeof(MainLayout)">
        <Onboarding InitialSettings="@_settings" OnCompleted="CompleteOnboarding" />
    </LayoutView>
}
else
{
    <InstallPrompt />
    <Router
        @key="CultureState.CurrentCulture.Name"
        AppAssembly="@typeof(App).Assembly"
        NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
}

@code {
    private CancellationTokenSource? _initializationCancellation;
    private Task? _initializationTask;
    private Exception? _initializationError;
    private bool _initialized;
    private AppSettings _settings = new();

    protected override void OnInitialized()
    {
        CultureState.Changed += OnCultureChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _initializationCancellation = new CancellationTokenSource();
        _initializationTask = InitializeAsync(_initializationCancellation.Token);
        await _initializationTask;
    }

    public void Dispose()
    {
        CultureState.Changed -= OnCultureChanged;
    }

    public async ValueTask DisposeAsync()
    {
        CultureState.Changed -= OnCultureChanged;

        var initializationCancellation = _initializationCancellation;
        _initializationCancellation = null;
        if (initializationCancellation is null)
        {
            return;
        }

        initializationCancellation.Cancel();
        if (_initializationTask is not null)
        {
            await _initializationTask;
        }

        initializationCancellation.Dispose();
    }

    private async void OnCultureChanged(object? sender, EventArgs args)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    private Task RetryInitializationAsync()
    {
        _initializationError = null;
        _initializationTask = InitializeAsync(_initializationCancellation!.Token);
        return _initializationTask;
    }

    private void CompleteOnboarding(AppSettings settings)
    {
        _settings = settings;
    }

    private async Task InitializeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await ActivityRepository.SeedDefaultsAsync(cancellationToken);
            _settings = await SettingsRepository.LoadAsync(cancellationToken);
            _initialized = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "DayPulse local data initialization failed.");
            _initializationError = exception;
            await InvokeAsync(StateHasChanged);
        }
    }
}
