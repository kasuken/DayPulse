@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> Localizer

<a class="daypulse-skip-link" href="#main-content"
   @onclick="SkipToMainContentAsync" @onclick:preventDefault="true">
    @Localizer["SkipToMainContent"]
</a>

<MudLayout Class="daypulse-shell">
    <MudAppBar Elevation="0" Class="daypulse-app-bar">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="daypulse-brand">
            <BrandMark />
            <MudText Typo="Typo.h6">@Localizer["ApplicationName"]</MudText>
        </MudStack>
        <MudSpacer />
        <div class="daypulse-device-status">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" aria-hidden="true" />
                <MudText Typo="Typo.body2">@Localizer["OnDevicePrivate"]</MudText>
            </MudStack>
        </div>
    </MudAppBar>

    <MudMainContent Class="daypulse-main-content">
        <main @ref="_mainContent" id="main-content" class="daypulse-page-main" tabindex="-1">
            <MudContainer MaxWidth="MaxWidth.Large" Class="daypulse-page-content">
                <DailyReminderHost />
                <UpdatePrompt />
                @Body
            </MudContainer>
        </main>
    </MudMainContent>

    <div class="daypulse-bottom-nav" data-testid="daypulse-bottom-nav">
        <MudPaper Class="daypulse-bottom-nav__surface" Elevation="0">
            <MudNavMenu
                Class="daypulse-bottom-nav__links"
                aria-label='@Localizer["PrimaryNavigation"]'>
                <MudNavLink
                    Href="/"
                    Match="NavLinkMatch.All"
                    ActiveClass="daypulse-bottom-nav__link--active"
                    Class="daypulse-bottom-nav__link"
                    ForceLoad="false"
                    Icon="@Icons.Material.Outlined.Today"
                    IconColor="Color.Inherit"
                    Ripple="false"
                    aria-label='@Localizer["Today"]'
                    data-testid="daypulse-nav-today">
                    @Localizer["Today"]
                </MudNavLink>
                <MudNavLink
                    Href="/history"
                    Match="NavLinkMatch.Prefix"
                    ActiveClass="daypulse-bottom-nav__link--active"
                    Class="daypulse-bottom-nav__link"
                    ForceLoad="false"
                    Icon="@Icons.Material.Outlined.History"
                    IconColor="Color.Inherit"
                    Ripple="false"
                    aria-label='@Localizer["History"]'
                    data-testid="daypulse-nav-history">
                    @Localizer["History"]
                </MudNavLink>
                <MudNavLink
                    Href="/insights"
                    Match="NavLinkMatch.Prefix"
                    ActiveClass="daypulse-bottom-nav__link--active"
                    Class="daypulse-bottom-nav__link"
                    ForceLoad="false"
                    Icon="@Icons.Material.Outlined.Insights"
                    IconColor="Color.Inherit"
                    Ripple="false"
                    aria-label='@Localizer["Insights"]'
                    data-testid="daypulse-nav-insights">
                    @Localizer["Insights"]
                </MudNavLink>
                <MudNavLink
                    Href="/settings"
                    Match="NavLinkMatch.Prefix"
                    ActiveClass="daypulse-bottom-nav__link--active"
                    Class="daypulse-bottom-nav__link"
                    ForceLoad="false"
                    Icon="@Icons.Material.Outlined.Settings"
                    IconColor="Color.Inherit"
                    Ripple="false"
                    aria-label='@Localizer["Settings"]'
                    data-testid="daypulse-nav-settings">
                    @Localizer["Settings"]
                </MudNavLink>
            </MudNavMenu>
            <div class="daypulse-nav-footer">
                <PrivacyNote />
            </div>
        </MudPaper>
    </div>
</MudLayout>

@code {
    private ElementReference _mainContent;

    private async Task SkipToMainContentAsync()
    {
        await _mainContent.FocusAsync();
    }
}
