@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> Localizer

<a class="daypulse-skip-link" href="#main-content">
    @Localizer["SkipToMainContent"]
</a>

<MudLayout Class="daypulse-shell">
    <MudAppBar Elevation="1" Class="daypulse-app-bar">
        <MudText Typo="Typo.h6" Class="ml-3">@Localizer["ApplicationName"]</MudText>
    </MudAppBar>

    <MudMainContent Class="daypulse-main-content">
        <main id="main-content" class="daypulse-page-main" tabindex="-1">
            <MudContainer MaxWidth="MaxWidth.Medium" Class="daypulse-page-content pa-4">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>

    <div class="daypulse-bottom-nav" data-testid="daypulse-bottom-nav">
        <MudPaper Class="daypulse-bottom-nav__surface" Elevation="8">
            <MudNavMenu
                Class="daypulse-bottom-nav__links"
                aria-label='@Localizer["PrimaryNavigation"]'>
                <MudNavLink
                    Href="/"
                    Match="NavLinkMatch.All"
                    ActiveClass="daypulse-bottom-nav__link--active"
                    Class="daypulse-bottom-nav__link"
                    ForceLoad="false"
                    Icon="@Icons.Material.Filled.Today"
                    IconColor="Color.Inherit"
                    Ripple="false"
                    aria-label='@Localizer["Today"]'
                    data-testid="daypulse-nav-today">
                    @Localizer["Today"]
                </MudNavLink>
                <MudNavLink
                    Href="/history"
                    Match="NavLinkMatch.Prefix"
                    ActiveClass="daypulse-bottom-nav__link--active"
                    Class="daypulse-bottom-nav__link"
                    ForceLoad="false"
                    Icon="@Icons.Material.Filled.History"
                    IconColor="Color.Inherit"
                    Ripple="false"
                    aria-label='@Localizer["History"]'
                    data-testid="daypulse-nav-history">
                    @Localizer["History"]
                </MudNavLink>
                <MudNavLink
                    Href="/insights"
                    Match="NavLinkMatch.Prefix"
                    ActiveClass="daypulse-bottom-nav__link--active"
                    Class="daypulse-bottom-nav__link"
                    ForceLoad="false"
                    Icon="@Icons.Material.Filled.Insights"
                    IconColor="Color.Inherit"
                    Ripple="false"
                    aria-label='@Localizer["Insights"]'
                    data-testid="daypulse-nav-insights">
                    @Localizer["Insights"]
                </MudNavLink>
                <MudNavLink
                    Href="/settings"
                    Match="NavLinkMatch.Prefix"
                    ActiveClass="daypulse-bottom-nav__link--active"
                    Class="daypulse-bottom-nav__link"
                    ForceLoad="false"
                    Icon="@Icons.Material.Filled.Settings"
                    IconColor="Color.Inherit"
                    Ripple="false"
                    aria-label='@Localizer["Settings"]'
                    data-testid="daypulse-nav-settings">
                    @Localizer["Settings"]
                </MudNavLink>
            </MudNavMenu>
        </MudPaper>
    </div>
</MudLayout>
